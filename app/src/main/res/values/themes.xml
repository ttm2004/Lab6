<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme -->
    <style name="Base.Theme.Lab6" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryVariant">@color/primary_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/secondary</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorAccent">@color/accent</item>
        <item name="android:windowBackground">@color/bg_main</item>
        <item name="android:statusBarColor">@color/primary</item>
    </style>

    <style name="Theme.Lab6" parent="Base.Theme.Lab6" />

    <!-- No ActionBar theme for activities that use their own toolbar -->
    <style name="Theme.Lab6.NoActionBar" parent="Theme.Lab6">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <!-- Splash screen theme - dùng NoActionBar thay vì Theme.SplashScreen
         để tránh lỗi "You need to use a Theme.AppCompat theme" -->
    <style name="Theme.Lab6.Splash" parent="Theme.Lab6.NoActionBar">
        <item name="android:windowBackground">@color/primary</item>
    </style>

    <!-- TextInputLayout styles -->
    <style name="Widget.Lab6.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/primary</item>
        <item name="hintTextColor">@color/primary</item>
    </style>

    <!-- Button styles -->
    <style name="Widget.Lab6.Button" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/primary</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Widget.Lab6.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
        <item name="strokeColor">@color/primary</item>
    </style>

    <!-- Shape appearance for photo top corners -->
    <style name="ShapeAppearance.PhotoTopRounded" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">@dimen/photo_corner</item>
        <item name="cornerSizeTopRight">@dimen/photo_corner</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>

    <!-- Shape appearance for circle avatar -->
    <style name="ShapeAppearance.CircleImage" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <!-- Text style for screen titles -->
    <style name="TextAppearance.Lab6.Title" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextAppearance.Lab6.Subtitle" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">@color/text_secondary</item>
    </style>
</resources>
